{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/uploads/[filename].js": {
      "includeFiles": "server/uploads/**"
    }
  },
  "rewrites": [
    {
      "source": "/uploads/:filename",
      "destination": "/api/uploads/:filename"
    }
  ]
}
